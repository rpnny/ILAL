{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilal.tech/schemas/issuer-credential-decisions-v1.json",
  "title": "ILAL Issuer Credential Decisions v1",
  "description": "PII-free issuer decisions consumed by the encrypted ILAL v2 issuer tree.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "credentials"],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "credentials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/credentialDecision"
      }
    }
  },
  "$defs": {
    "credentialDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wallet", "kycLevel", "countryCode", "status"],
      "properties": {
        "wallet": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "kycLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "countryCode": {
          "description": "ISO 3166-1 numeric country code.",
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        },
        "expiresAt": {
          "description": "Unix timestamp or ISO-8601 date. Omit to use the CLI import default.",
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "string", "format": "date-time" }
          ]
        },
        "expiresInDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "status": {
          "enum": ["approved", "active", "rejected", "revoked", "denied"]
        },
        "verificationId": {
          "description": "Provider reference. ILAL stores only its domain-separated hash.",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
