{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilal.xyz/schemas/issuer-pilot-config-v1.json",
  "title": "ILAL issuer pilot configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "chainId", "roles", "assets", "scenario", "policy"],
  "properties": {
    "format": { "const": "ilal-issuer-pilot-config-v1" },
    "chainId": { "type": "integer", "minimum": 1 },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deployer", "issuer", "settlementAssetOperator", "liquidityProvider", "institutionA", "institutionB", "executor"],
      "properties": {
        "deployer": { "$ref": "#/$defs/address" },
        "issuer": { "$ref": "#/$defs/address" },
        "settlementAssetOperator": { "$ref": "#/$defs/address" },
        "liquidityProvider": { "$ref": "#/$defs/address" },
        "institutionA": { "$ref": "#/$defs/address" },
        "institutionB": { "$ref": "#/$defs/address" },
        "executor": { "$ref": "#/$defs/address" }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuerStablecoin", "settlementCash"],
      "properties": {
        "issuerStablecoin": { "$ref": "#/$defs/asset" },
        "settlementCash": { "$ref": "#/$defs/asset" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuerAssetInput", "settlementCashInput", "tickLower", "tickUpper", "liquidityDelta"],
      "properties": {
        "issuerAssetInput": { "const": "100000000" },
        "settlementCashInput": { "const": "70000000" },
        "tickLower": { "const": -1000 },
        "tickUpper": { "const": 1000 },
        "liquidityDelta": { "type": "string", "pattern": "^[1-9][0-9]*$" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "grantTtlSeconds"],
      "properties": {
        "mode": { "const": "CNF_ONLY" },
        "grantTtlSeconds": { "type": "integer", "minimum": 60, "maximum": 604800 }
      }
    }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "symbol", "decimals", "role"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string", "minLength": 1 },
        "decimals": { "const": 6 },
        "role": { "enum": ["issuer-stablecoin", "sandbox-settlement-cash"] }
      }
    }
  }
}
