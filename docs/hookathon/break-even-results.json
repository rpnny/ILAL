    "matchingPattern": "anchor token0 order N; opposing token1 order 0.7N; gross notional 1.7N",
    "savingsUsdPerAnchorDollar": 0.0006999945605439456,
    "savingsBpsOfAnchorNotional": 6.999945605439456,
    "conservativeGasPremium": 485401,
    "gasPremiumRule": "maximum measured total-gas premium across comparable scaled-liquidity rows",
    "totalGasDefinition": "measured execution gas plus calldata gas and 21,000 intrinsic gas for one ILAL transaction versus two independent vanilla transactions"
