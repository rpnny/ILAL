{
  "name": "@ilal/cli",
  "version": "1.0.0-dev.0",
  "description": "ILAL CLI \u2014 policy-controlled atomic execution and settlement",
  "type": "module",
  "bin": {
    "ilal": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "Apache-2.0",
  "keywords": [
    "uniswap",
    "uniswap-v4",
    "compliance",
    "kyc",
    "zk-proof",
    "defi",
    "rwa",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rpnny/ilal.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/rpnny/ilal/tree/main/cli#readme",
  "scripts": {
    "build": "rm -rf dist && npm run build --prefix ../sdk && tsc && node scripts/copy-console-assets.mjs",
    "dev": "node --loader ts-node/esm src/index.ts",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@zk-kit/incremental-merkle-tree": "^1.1.0",
    "commander": "^12.0.0",
    "poseidon-lite": "^0.3.0",
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@ilal/sdk": "file:../sdk",
    "@types/node": "^20",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "brace-expansion": "^2.1.4",
    "underscore": "1.13.8",
    "ws": "^8.21.0"
  },
  "private": true
}
